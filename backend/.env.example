# ---------- CORS Origins ----------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- PostgreSQL Database ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_sharing_platform

# ---------- Object Storage (MinIO / S3 / Cloudflare R2) ----------
MINIO_HOST=localhost
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Leave empty for local Docker. For production or Cloudflare R2, set the public URL for client downloads
MINIO_PUBLIC_ENDPOINT=

# ---------- Authentication (JWT) ----------
# Secret key for signing JWT tokens (minimum 32 random characters)
JWT_SECRET_KEY=your_super_secret_jwt_key_here_at_least_32_chars

# ---------- Default System Admin Seed ----------
ADMIN_EMAIL=admin@ou.edu.vn
ADMIN_PASSWORD=Admin@123456

# ---------- Google Gemini & OAuth ----------
# Google AI Studio API key (required for RAG Chat & Quiz Studio)
GOOGLE_API_KEY=your_gemini_api_key_here
# Google OAuth Client ID for Google Login (optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# ---------- Embedding & Reranking (Jina AI / Gemini) ----------
# Provider: 'jina' (recommended for higher rate limits) or 'gemini'
EMBEDDING_PROVIDER=jina
JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ENABLE_RERANKER=true

# ---------- LLM Observability (Langfuse - Optional) ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- Document Conversion (Cloudmersive - Optional) ----------
CLOUDMERSIVE_API_KEY=

# ---------- VNPay Payment Gateway (Sandbox Defaults) ----------
VNPAY_TMN_CODE=SXWSOPBU
VNPAY_SECURE_SECRET=EBAUOJATBQVUPSCODHIGDBNREAWHUIBU
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
VNPAY_IPN_URL=http://localhost:8000/payments/vnpay-ipn

# ---------- Redis & ARQ Worker ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0