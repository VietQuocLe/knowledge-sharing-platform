# ---------- App Configuration ----------
APP_NAME=Knowledge Sharing Platform
DEBUG=False

# ---------- CORS (comma-separated list for production / vercel) ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# ---------- PostgreSQL Database ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_sharing_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---------- Object Storage (MinIO / Cloudflare R2 / S3) ----------
MINIO_HOST=localhost
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=knowledge-assets
MINIO_SECURE=False
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ---------- File Upload & Notebook Quota ----------
MAX_FILE_SIZE_MB=30
MAX_SOURCES_PER_NOTEBOOK=10

# ---------- Authentication (JWT) ----------
JWT_SECRET_KEY=your_super_secret_jwt_key_here_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- Default System Admin ----------
ADMIN_EMAIL=admin@ou.edu.vn
ADMIN_PASSWORD=Admin@123456
ADMIN_FULL_NAME=Quản trị viên Hệ thống

# ---------- Google Gemini & Embedding ----------
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_RPM_LIMIT=80
GEMINI_EMBEDDING_TPM_LIMIT=26000
GEMINI_EMBEDDING_TPM_BUDGET_PER_BATCH=24000
GEMINI_EMBEDDING_MAX_CHUNKS_PER_BATCH=80

# ---------- Observability (Langfuse) ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- Document Conversion (Cloudmersive) ----------
CLOUDMERSIVE_API_KEY=

