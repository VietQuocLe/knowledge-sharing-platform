# ---------- App & Network ----------
APP_NAME="Knowledge Sharing Platform"
DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://knowledge-sharing-platform-six.vercel.app

# ---------- PostgreSQL Database ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_sharing_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---------- Object Storage (MinIO / Cloudflare R2 / S3) ----------

MINIO_HOST=localhost
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=resources
MINIO_SECURE=False
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ---------- Authentication (JWT) ----------
JWT_SECRET_KEY=your_super_secret_jwt_key_here_at_least_32_chars

# ---------- Default System Admin Seed ----------
ADMIN_EMAIL=admin@ou.edu.vn
ADMIN_PASSWORD=Admin@123456

# ---------- Google AI (Gemini) & OAuth ----------
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---------- LLM Observability (Langfuse Cloud) ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- Document Conversion (Cloudmersive - Optional) ----------
CLOUDMERSIVE_API_KEY=

