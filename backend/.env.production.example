# ---------- [1] CORS Origins (Frontend Domains) ----------

CORS_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173

# ---------- [2] PostgreSQL Database (Supabase Session Pooler) ----------

POSTGRES_HOST=aws-0-ap-southeast-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.your_supabase_project_ref
POSTGRES_PASSWORD=your_supabase_db_password
POSTGRES_DB=postgres

# ---------- [3] Object Storage (Cloudflare R2) ----------

MINIO_HOST=your_account_id.r2.cloudflarestorage.com
MINIO_API_PORT=443
MINIO_ROOT_USER=your_cloudflare_r2_access_key_id
MINIO_ROOT_PASSWORD=your_cloudflare_r2_secret_access_key
MINIO_BUCKET_NAME=resources
MINIO_SECURE=true

MINIO_PUBLIC_ENDPOINT=https://pub-your_bucket_id.r2.dev

# ---------- [4] Authentication & Admin Seed ----------
JWT_SECRET_KEY=replace_with_a_secure_random_string_at_least_32_chars_long
ADMIN_EMAIL=admin@ou.edu.vn
ADMIN_PASSWORD=Admin@123456

# ---------- [5] Google Gemini & Jina AI (RAG & Chat) ----------
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Provider: 'jina' or 'gemini'
EMBEDDING_PROVIDER=jina
JINA_API_KEY=your_jina_api_key_here
ENABLE_RERANKER=true

# ---------- [6] Async Task Queue (Upstash Redis) ----------
REDIS_URL=rediss://default:your_upstash_password@your_endpoint.upstash.io:6379

# ---------- [7] VNPay Payment Gateway (Sandbox Defaults) ----------
VNPAY_TMN_CODE=SXWSOPBU
VNPAY_SECURE_SECRET=EBAUOJATBQVUPSCODHIGDBNREAWHUIBU
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-frontend-app.vercel.app/payment/vnpay-return
VNPAY_IPN_URL=https://your-backend-service.onrender.com/payments/vnpay-ipn

# ---------- [8] Optional Integrations ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
CLOUDMERSIVE_API_KEY=

